# --- MongoDB (локально через docker compose) ---
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_root_password
MONGO_APP_USERNAME=shipa_app
MONGO_APP_PASSWORD=change_me_app_password
MONGODB_DB_NAME=shipa_info

# Для Next.js (Vercel) и бота на сервере — один URI к Mongo на сервере:
# MONGODB_URI=mongodb://shipa_app:PASSWORD@YOUR_SERVER_IP:27017/shipa_info?authSource=shipa_info

# Локальная разработка после docker compose up:
MONGODB_URI=mongodb://shipa_app:change_me_app_password@127.0.0.1:27017/shipa_info?authSource=shipa_info

# --- Telegram (только на сервере, где крутится bot/) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Числовые user id через запятую (узнать: @userinfobot)
TELEGRAM_ADMIN_IDS=123456789
